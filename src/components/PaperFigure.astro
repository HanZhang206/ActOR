---
import type { ImageMetadata } from "astro";
import Picture from "./Picture.astro";
import { withBase } from "../lib/withBase";

interface Props {
  src: ImageMetadata;
  alt: string;
  href?: string;
  plain?: boolean;
  class?: string;
}

const { src, alt, href, plain = false, class: className } = Astro.props;
---

<figure class:list={["paper-figure", className]}>
  {plain && href ? (
    <img src={withBase(href)} alt={alt} />
  ) : (
    <div class="figure-frame">
      <Picture src={src} alt={alt} />
    </div>
  )}
  {Astro.slots.has("default") && <figcaption><slot /></figcaption>}
</figure>
